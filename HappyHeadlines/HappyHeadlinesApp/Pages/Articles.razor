@page "/articles"
@using System.Net.Http.Json
@using HappyHeadlinesApp.Models
@inject HttpClient Http

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6">
    <MudText Typo="Typo.h3" Class="mb-6">
        Articles
    </MudText>

    @if (articles is null)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else
    {
        <MudGrid>
            @foreach (var article in articles)
            {
                <MudItem xs="12" md="6">
                    <MudCard Class="h-100">
                        <MudCardContent>
                            <div class="d-flex justify-space-between align-center mb-3">
                                <MudChip T="string" Size="Size.Small">
                                    @article.Location
                                </MudChip>
                                <MudText Typo="Typo.caption">
                                    #@article.Id
                                </MudText>
                            </div>

                            <MudText Typo="Typo.h5" Class="mb-3">
                                @article.Title
                            </MudText>

                            <MudText Typo="Typo.body2" Class="mb-4">
                                By @article.JournalistName
                            </MudText>

                            <MudText Typo="Typo.body2" Class="mb-4">
                                @article.BreadText
                            </MudText>

                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                @article.SectionName
                            </MudChip>

                            <MudDivider Class="my-4" />

                            <MudText Typo="Typo.h6" Class="mb-3">
                                Comments (@article.Comments.Count())
                            </MudText>

                            @if (!article.Comments.Any())
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    No comments yet.
                                </MudText>
                            }
                            else
                            {
                                <MudStack Spacing="2">
                                    @foreach (var comment in article.Comments)
                                    {
                                        <MudPaper Class="pa-3" Elevation="0">
                                            <div class="d-flex justify-space-between align-center mb-1">
                                                <MudText Typo="Typo.subtitle2">
                                                    @comment.AuthorName
                                                </MudText>
                                                <MudText Typo="Typo.caption">
                                                    @comment.CreatedDate.ToLocalTime().ToString("g")
                                                </MudText>
                                            </div>
                                            <MudText Typo="Typo.body2">
                                                @comment.Text
                                            </MudText>
                                        </MudPaper>
                                    }
                                </MudStack>
                            }
                        </MudCardContent>

                        <MudCardActions>
                            <MudText Typo="Typo.caption">
                                Created @article.CreatedDate.ToLocalTime().ToString("g")
                            </MudText>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
</MudContainer>

@code {
    private IEnumerable<Article>? articles;
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Fetch articles
            IEnumerable<ArticleDTO>? articleDtos = null;
            try
            {
                articleDtos = await Http.GetFromJsonAsync<IEnumerable<ArticleDTO>>(
                    "http://localhost:5000/api/articles/eu");
            }
            catch (Exception ex)
            {
                errorMessage = $"Failed to load articles: {ex.Message}";
                isLoading = false;
                StateHasChanged(); // Update UI to show error
                return;
            }

            if (articleDtos is null)
            {
                errorMessage = "No articles found.";
                isLoading = false;
                StateHasChanged();
                return;
            }

            // Fetch comments for all articles in parallel
            var commentTasks = articleDtos.Select(async articleDto =>
            {
                try
                {
                    return await Http.GetFromJsonAsync<IEnumerable<Comment>>(
                        $"http://localhost:8083/api/eu/{articleDto.Id}") ?? Enumerable.Empty<Comment>();
                }
                catch (Exception ex)
                {
                    // Log error for this article's comments but continue
                    Console.Error.WriteLine($"Failed to load comments for article {articleDto.Id}: {ex.Message}");
                    return Enumerable.Empty<Comment>();
                }
            });

            var commentResults = await Task.WhenAll(commentTasks);

            // Map articles with their comments
            var loadedArticles = articleDtos.Select((articleDto, index) => new Article
            {
                Id = articleDto.Id,
                JournalistName = articleDto.JournalistName,
                Title = articleDto.Title,
                CreatedDate = articleDto.CreatedDate,
                Location = articleDto.Location,
                SectionName = articleDto.SectionName,
                BreadText = articleDto.BreadText,
                Comments = commentResults[index]
            }).ToList();

            articles = loadedArticles;
        }
        catch (Exception ex)
        {
            errorMessage = $"An unexpected error occurred: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged(); // Ensure UI updates
        }
    }

    private class Article : ArticleDTO
    {
        public IEnumerable<Comment> Comments { get; set; } = Enumerable.Empty<Comment>();
    }

    public class ArticleDTO
    {
        public long Id { get; set; }
        public string JournalistName { get; set; } = string.Empty;
        public string Title { get; set; } = string.Empty;
        public DateTimeOffset CreatedDate { get; set; }
        public string Location { get; set; } = string.Empty;
        public string SectionName { get; set; } = string.Empty;
        public string BreadText { get; set; } = string.Empty;
    }
}
