{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient.OtlpLogExporter": "Warning"
    }
  },

  "AllowedHosts": "*",

  "WebApp": {
    "BaseUrl": "http://localhost:8000"
  },

  "RabbitMQ": {
    //"HostName": "rabbitmq",
