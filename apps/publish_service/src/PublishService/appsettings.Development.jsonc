    "UserName": "admin",
    "Password": "admin"
  },
  
  "DraftService": {
    //"BaseUrl": "http://draftservice:8080",
    "BaseUrl": "http://localhost:8083"
  },

  "OpenTelemetry": {
    //    "LogsEndpoint": "http://otel-collector:4318/v1/logs"
    "LogsEndpoint": "http://localhost:4318/v1/logs"
  }
