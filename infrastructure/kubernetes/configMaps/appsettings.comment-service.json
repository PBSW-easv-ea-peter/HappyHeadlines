{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "ConnectionStrings": {
    "CommentDatabase": "Host=comment-db.prod.svc.cluster.local;Port=5432;Database=comments;Username=postgres"
  },

  "ProfanityService": {
    "BaseUrl": "http://profanityservice:8081"
  },

  "OpenTelemetry": {
    "Endpoint": "http://otel-collector:4318"
  },

  "Cache": {
    "RedisConnection": "comment-cache:6379",
    "Capacity": 30
  },

  "WebApp": {
    "BaseUrl": "http://localhost:8000"
  },

  "ReaderWeb": {
    "BaseUrl": "http://localhost:8001"
  }
}
