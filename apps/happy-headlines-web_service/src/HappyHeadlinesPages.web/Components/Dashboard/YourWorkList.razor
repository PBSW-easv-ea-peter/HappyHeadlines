@using HappyHeadlinesPages.web.Models

<MudText Typo="Typo.h5" Class="mb-3">Continue Your Work</MudText>

@if (!Drafts.Any())
{
    <MudText Typo="Typo.body2" Color="Color.Secondary">No drafts in progress.</MudText>
}
else
{
    <MudStack Spacing="2">
        @foreach (var draft in Drafts)
        {
            <MudPaper Class="pa-4" Elevation="0" Outlined="true"
                      Style="@($"border-left: 4px solid {DraftAccentColors.For(draft.Status, draft.ReviewNote)};")">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                    <div>
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.subtitle1">@draft.Title</MudText>
                            <DraftStatusBadge Status="@draft.Status" FlaggedWords="@draft.FlaggedWords" ReviewNote="@draft.ReviewNote" />
                        </MudStack>
                        <MudText Typo="Typo.caption">
                            @Sections.NameOf(draft.SectionId) &middot; Last edited @draft.LastEditedDate.ToLocalTime().ToString("g")
                        </MudText>
                    </div>

                    @if (draft.Status == DraftStatus.WorkInProgress)
                    {
                        <MudButton Variant="Variant.Outlined" Href="@($"/drafts/{draft.Id}/edit")">
                            Continue editing
                        </MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Text" Href="@($"/drafts/{draft.Id}/edit")">
                            View
                        </MudButton>
                    }
                </MudStack>
            </MudPaper>
        }
    </MudStack>
}
