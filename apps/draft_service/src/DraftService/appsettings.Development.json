{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "ConnectionStrings": {
    // To run locally
//    "DraftDatabase": "Host=localhost;Port=5442;Database=drafts;Username=postgres;Password=Postgres1234"

    // If run in container
    "DraftDatabase": "Host=draftdb;Port=5432;Database=drafts;Username=postgres;Password=Postgres1234"
  },

  "ProfanityService": {
    // To run locally
//    "BaseUrl": "http://localhost:8081"

    // If run in container
    "BaseUrl": "http://profanityservice:8081"
  },

  "OpenTelemetry": {
    // To run locally
//    "LogsEndpoint": "http://localhost:4318/v1/logs"

    // If run in container
    "LogsEndpoint": "http://otel-collector:4318/v1/logs"
  },

  "WebApp": {
    "BaseUrl": "http://localhost:8000"
  }
}
