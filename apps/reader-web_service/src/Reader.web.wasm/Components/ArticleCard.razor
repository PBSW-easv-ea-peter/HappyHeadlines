@using ReaderPages.web.Models
<a href="@ArticleDisplay.Href(Article)" class="card-link article-card" style="@($"border-top-color:{Sections.ColorOfName(Article.SectionName)};")">
    <SectionBadge Name="@Article.SectionName" />
    <MudText Typo="Typo.subtitle1" Class="article-card-title card-link-title">@Article.Title</MudText>
    <MudText Typo="Typo.body2" Class="muted article-card-excerpt">@ArticleDisplay.Excerpt(Article.BreadText, ExcerptLength)</MudText>
    <MudText Typo="Typo.caption" Class="muted">@Article.Byline &middot; @ArticleDisplay.FormatDate(Article)</MudText>
</a>

@code {
    // Also sent to ArticleService, so only this many characters of body text are fetched.
    public const int ExcerptLength = 110;

    [Parameter, EditorRequired]
    public ArticleDTO Article { get; set; } = default!;
}
