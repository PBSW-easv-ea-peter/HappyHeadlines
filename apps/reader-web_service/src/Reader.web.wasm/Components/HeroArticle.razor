@using ReaderPages.web.Models
<a href="@ArticleDisplay.Href(Article)" class="card-link hero-article" style="@($"border-top-color:{Sections.ColorOfName(Article.SectionName)};")">
    <MudText Typo="Typo.overline" Class="hero-kicker">Today's highlight</MudText>

    <MudText Typo="Typo.h3" HtmlTag="h1" Class="hero-title card-link-title">@Article.Title</MudText>

    <div class="article-meta">
        <SectionBadge Name="@Article.SectionName" />
        <span>By @Article.Byline</span>
        <span>&middot;</span>
        <span>@ArticleDisplay.FormatDate(Article)</span>
    </div>

    <MudText Typo="Typo.body1" Class="hero-excerpt">@ArticleDisplay.Excerpt(Article.BreadText, ExcerptLength)</MudText>
</a>

@code {
    // Also sent to ArticleService, so only this many characters of body text are fetched.
    public const int ExcerptLength = 400;

    [Parameter, EditorRequired]
    public ArticleDTO Article { get; set; } = default!;
}
