{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "ConnectionStrings": {
    // To run locally
//    "CommentDatabase": "Host=localhost;Port=5440;Database=comments;Username=postgres;Password=Postgres1234"
    
    // If run in container
    "CommentDatabase": "Host=commentdb;Port=5432;Database=comments;Username=postgres;Password=Postgres1234"
  },
 
  "ProfanityService": {
