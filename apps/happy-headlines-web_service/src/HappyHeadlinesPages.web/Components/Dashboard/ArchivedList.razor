@using HappyHeadlinesPages.web.Models

<MudText Typo="Typo.h6" Class="mb-3">Archived</MudText>

@if (!Drafts.Any())
{
    <MudText Typo="Typo.body2" Color="Color.Secondary">Nothing archived.</MudText>
}
else
{
    <MudStack Spacing="2">
        @foreach (var draft in Drafts)
        {
            <MudPaper Class="pa-4" Elevation="0" Outlined="true"
                      Style="@($"border-left: 4px solid {DraftAccentColors.For(draft.Status, null)};")">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                    <div>
                        <MudText Typo="Typo.subtitle1">@draft.Title</MudText>
                        <MudText Typo="Typo.caption">
                            @Sections.NameOf(draft.SectionId) &middot; Last edited @draft.LastEditedDate.ToLocalTime().ToString("g")
                        </MudText>
                    </div>

                    <MudStack Row="true" Spacing="2">
                        <MudButton Variant="Variant.Text" Href="@($"/drafts/{draft.Id}/edit")">
                            View
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                   OnClick="@(() => OnReactivate.InvokeAsync(draft.Id))">
                            Reactivate
                        </MudButton>
                    </MudStack>
                </MudStack>
            </MudPaper>
        }
    </MudStack>
}
