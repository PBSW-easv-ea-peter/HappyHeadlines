{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "ConnectionStrings": {
    // To run locally
//    "ProfanityDatabase": "Host=localhost;Port=5441;Database=profanity;Username=postgres;Password=Postgres1234"

    // If run in container
    "ProfanityDatabase": "Host=profanitydb;Port=5432;Database=profanity;Username=postgres;Password=Postgres1234"
  },

  "OpenTelemetry": {
    "LogsEndpoint": "http://otel-collector:4318/v1/logs",
    //    "LogsEndpoint": "http://localhost:4318/v1/logs",

    "TracesEndpoint": "http://otel-collector:4318/v1/traces"
    //    "TracesEndpoint": "http://localhost:4318/v1/traces"
  }
}
