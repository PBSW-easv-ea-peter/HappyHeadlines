<MudItem xs="12" sm="6" md="3">
    <MudPaper Class="pa-4 cursor-pointer" Elevation="0" Style="@BackgroundStyle">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <div>
                <MudText Typo="Typo.h4" Style="@TextStyle">@Count</MudText>
                <MudText Typo="Typo.body2">@Title</MudText>
            </div>
            <MudIcon Icon="@Icon" Style="@TextStyle" Size="Size.Large" />
        </MudStack>
    </MudPaper>
</MudItem>
