{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "RabbitMQ": {
    "HostName": "localhost",
    "UserName": "admin",
    "Password": "admin"
  },

  "OpenTelemetry": {
    //    "Endpoint": "http://otel-collector:4318"
    "Endpoint": "http://localhost:4318"
  },

  "NewsletterIntervals": {
    "Intervals": [
      {
        "Interval": "Daily",
        "HourOfDay": 8
      },
      {
        "Interval": "Weekly",
        "DayOfWeek": 6, // Sunday = 0
        "HourOfDay": 8
      }
    ]
  },
  
  "FeatureToggles": {
    "Toggles": [
      {
        "Name": "UseSubscriberService",
        "State": false
      }
    ]
  }
}
