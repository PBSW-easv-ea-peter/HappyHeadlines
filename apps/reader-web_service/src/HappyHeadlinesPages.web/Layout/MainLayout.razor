@inherits LayoutComponentBase
@inject CurrentJournalistState JournalistState

@* Required *@
<MudThemeProvider Theme="@_theme" IsDarkMode="_isDarkMode" />
<MudPopoverProvider />

@* Needed for dialogs *@
<MudDialogProvider />

@* Needed for snackbars *@
<MudSnackbarProvider />

<MudLayout>

    <MudAppBar Elevation="0" Class="border-bottom header" id="appBar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="@DrawerToggle" />

        <MudGrid Class="w-100 align-center">

            <!-- Left -->
            <MudItem xs="4" Class="d-flex justify-start align-center">
                <MudIconButton Icon="@DarkLightModeButtonIcon"
                               Color="Color.Inherit"
                               Size="Size.Small"
                               Ripple="false"
                               OnClick="@DarkModeToggle" />

                <MudLink Href="@PageRoutes.Home"
                         Target="_blank"
                         Color="Color.Inherit">
                    <MudIconButton Icon="@("fa-brands fa-instagram")"
                                   Color="Color.Inherit"
                                   Size="Size.Small"/>
                </MudLink>
            </MudItem>

            <!-- Center -->
            <MudItem xs="4" Class="d-flex justify-center align-center header-top-center">
                <MudLink Href="@PageRoutes.Home"
                         Color="Color.Inherit"
                         Underline="Underline.None">
                    <MudText Typo="Typo.h5" Class="site-wordmark">
                        Happy Headlines
                    </MudText>
                </MudLink>
            </MudItem>

            <!-- Right -->
            <MudItem xs="4" Class="header-top-right d-flex justify-end align-center" >
                <MudLink Href="@PageRoutes.Administration"
                         Color="Color.Inherit"
                         Underline="Underline.None">
                    <MudText Typo="Typo.h6" Class="appointment-text">
                        To Administration
                    </MudText>
                </MudLink>
            </MudItem>

        </MudGrid>
    </MudAppBar>

    <!-- Side nav -->
    <MudDrawer Open="_drawerOpen"
               Elevation="1"
               ClipMode="DrawerClipMode.Always"
               Variant="DrawerVariant.Persistent"
               Width="240px">
        <Navbar />
    </MudDrawer>

    <!-- Main -->
    <MudMainContent>
        @Body
    </MudMainContent>

</MudLayout>
