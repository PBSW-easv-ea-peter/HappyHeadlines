{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "ConnectionStrings": {
    // To run locally
    "CommentDatabase": "Host=localhost;Port=5440;Database=comments;Username=postgres;Password=Postgres1234"
    
    // If run in container
//    "CommentDatabase": "Host=commentdb;Port=5432;Database=comments;Username=postgres;Password=Postgres1234"
  },
 
  "ProfanityService": {
    // To run locally
    "BaseUrl": "http://localhost:8081"

    // If run in container
 //   "BaseUrl": "http://profanityservice:8081"
  },

  "OpenTelemetry": {
    // To run locally
    "Endpoint": "http://localhost:4318"

    // If run in container
//    "Endpoint": "http://otel-collector:4318"
  },

  "Cache": {
    // To run locally
    "RedisConnection": "localhost:6380",

    // If run in container
//    "RedisConnection": "comment-cache:6379",

    // Number of articles whose comments are kept in the cache (LRU eviction)
    "Capacity": 30
  },

  "WebApp": {
    "BaseUrl": "http://localhost:8000"
  }
}
