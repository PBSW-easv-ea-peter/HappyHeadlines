{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Polly": "Warning"
    }
  },

  "AllowedHosts": "*",

  "JournalistWeb": {
    "BaseUrl": "http://192.168.1.29:80"
  },

  "ReaderWeb": {
    "BaseUrl": "http://192.168.1.29:81"
  },

  "Cache": {
    "RedisConnection": "article-cache:6379"
  },

  "ArticleShards": {
    "EU": "Host=article-db-eu.prod.svc.cluster.local;Port=5432;Database=articles;Username=postgres;Password=${ARTICLE_DB_PWD}",
    "NA": "Host=article-stack_db-na;Port=5432;Database=articles;Username=postgres;Password=${ARTICLE_DB_PWD}",
    "SA": "Host=article-stack_db-sa;Port=5432;Database=articles;Username=postgres;Password=${ARTICLE_DB_PWD}",
    "AU": "Host=article-stack_db-au;Port=5432;Database=articles;Username=postgres;Password=${ARTICLE_DB_PWD}",
    "AS": "Host=article-stack_db-as;Port=5432;Database=articles;Username=postgres;Password=${ARTICLE_DB_PWD}",
    "AN": "Host=article-stack_db-an;Port=5432;Database=articles;Username=postgres;Password=${ARTICLE_DB_PWD}",
    "AF": "Host=article-stack_db-af;Port=5432;Database=articles;Username=postgres;Password=${ARTICLE_DB_PWD}",
    "GO": "Host=article-stack_db-global;Port=5432;Database=articles;Username=postgres;Password=${ARTICLE_DB_PWD}"
  },

  "RabbitMQ": {
    "HostName": "rabbitmq",
    "UserName": "admin",
    "Password": "admin"
  },

  "OpenTelemetry": {
    "Endpoint": "http://otel-collector:4318"
  }
