{
  "uid": "cache-hit-ratio",
  "title": "Cache hit ratio",
  "tags": ["redis", "cache"],
  "schemaVersion": 39,
  "editable": true,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "article_capacity",
        "type": "constant",
        "hide": 2,
        "description": "Bytes of article data that fit in ArticleCache: 150 articles x 5 186 B. Keep in sync with maxmemory.",
        "query": "780000"
      },
      {
        "name": "comment_capacity",
        "type": "constant",
        "hide": 2,
        "description": "Bytes of comment data that fit in CommentCache: 50 articles x 2 613 B. Keep in sync with maxmemory.",
        "query": "131000"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Exporter connected to Redis",
      "description": "redis_up from redis_exporter. Down means the exporter runs but cannot reach its cache.",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "redis_up", "legendFormat": "{{cache}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": {
              "0": { "text": "Down", "color": "red" },
              "1": { "text": "Up", "color": "green" }
            } }
          ],
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "value": null, "color": "red" },
            { "value": 1, "color": "green" }
          ] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Hit ratio (last 5m)",
      "gridPos": { "x": 6, "y": 0, "w": 9, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cache) (rate(redis_keyspace_hits_total[5m])) / (sum by (cache) (rate(redis_keyspace_hits_total[5m])) + sum by (cache) (rate(redis_keyspace_misses_total[5m])))",
          "legendFormat": "{{cache}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "value": null, "color": "red" },
            { "value": 0.5, "color": "orange" },
            { "value": 0.8, "color": "green" }
          ] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "Cache fill level",
      "description": "Share of the cache's capacity in use. Measured as free space: 1 - (maxmemory - used memory) / capacity, because an empty Redis already uses ~1.7 MB of its own. 100% = Redis starts evicting. Capacity is the dashboard constants article_capacity / comment_capacity - keep them in sync with maxmemory in docker-compose.dev.yaml.",
      "gridPos": { "x": 15, "y": 0, "w": 9, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "clamp_min(1 - (redis_memory_max_bytes{cache=\"article\"} - redis_memory_used_bytes{cache=\"article\"}) / $article_capacity, 0) and redis_memory_max_bytes{cache=\"article\"} > 0",
          "legendFormat": "article"
        },
        {
          "refId": "B",
          "expr": "clamp_min(1 - (redis_memory_max_bytes{cache=\"comment\"} - redis_memory_used_bytes{cache=\"comment\"}) / $comment_capacity, 0) and redis_memory_max_bytes{cache=\"comment\"} > 0",
          "legendFormat": "comment"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 0,
          "noValue": "No limit set",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "value": null, "color": "green" },
            { "value": 0.7, "color": "yellow" },
            { "value": 0.9, "color": "red" }
          ] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdMarkers": true
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Hit ratio over time",
      "gridPos": { "x": 0, "y": 6, "w": 24, "h": 10 },
      "interval": "1m",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cache) (rate(redis_keyspace_hits_total[$__rate_interval])) / (sum by (cache) (rate(redis_keyspace_hits_total[$__rate_interval])) + sum by (cache) (rate(redis_keyspace_misses_total[$__rate_interval])))",
          "legendFormat": "{{cache}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": { "drawStyle": "bars", "fillOpacity": 80, "barAlignment": 0, "lineWidth": 1 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Hits and misses per second",
      "description": "Raw traffic behind the ratio - a 100% ratio on 1 request means little.",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (cache) (rate(redis_keyspace_hits_total[$__rate_interval]))", "legendFormat": "{{cache}} hits" },
        { "refId": "B", "expr": "sum by (cache) (rate(redis_keyspace_misses_total[$__rate_interval]))", "legendFormat": "{{cache}} misses" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      }
    }
  ]
}
